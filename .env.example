# Postgres connection string. Use Neon, Supabase, or local Postgres.
DATABASE_URL=postgres://user:password@localhost:5432/anthem

# Random 32+ char secret used to sign session cookies.
SESSION_SECRET=replace-with-a-long-random-string

# Optional: Sentry error monitoring. Leave unset to disable Sentry entirely.
# SENTRY_DSN=https://...ingest.sentry.io/...
# NEXT_PUBLIC_SENTRY_DSN=https://...ingest.sentry.io/...
# Required for source-map upload during build (set SENTRY_ORG and SENTRY_PROJECT
# together with SENTRY_DSN to enable the build-time integration):
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
