[Unit]
Description=Anthem Postgres backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/srv/anthem/current/deploy/backup.sh
EnvironmentFile=-/etc/anthem/backup.env

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/anthem/backups
